; config/.env.example  (safe to commit - NO real secrets here)
; Copy this file to config/.env and fill in your own local values.
; Use ; for comments - parse_ini_file needs it. Put values with special characters in "quotes".
APP_ENV=local
DB_HOST=127.0.0.1
DB_NAME=bedlink
DB_USER=root
DB_PASS=
RELATIVE_PEPPER=change-this-to-a-long-random-string
; Set to off while teammates are testing, on for the demo (Recipe 2.4, step 4)
TWO_STEP=off
